# ========== Client (Vite) ==========
# Exposed to the browser. Use the Supabase "anon" key ONLY — never the service key.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...

# ========== Server (Vercel serverless / api/*) ==========
# Used by api/claude.js to verify Supabase JWTs on incoming requests.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbG...

# ========== Anthropic API ==========
# Server-side only. Never expose this key to the client.
ANTHROPIC_API_KEY=sk-ant-...

# ========== Sentry (任意) ==========
# 設定すると production ビルドだけが Sentry にエラーを送る。dev / preview
# は no-op。Vercel ダッシュボード → Project Settings → Environment Variables
# に Production スコープでセットすること。未設定なら Sentry は完全停止。
VITE_SENTRY_DSN=https://xxxxxxxxxxxx@o0.ingest.sentry.io/0

# 🏷 サービス名「Orime」に揃える外向きの値（旧名 leverage を利用者に見せないため・任意）
# 本番サイトの URL（規約リンク・共有用 URL。末尾スラッシュなし）
VITE_SITE_URL=
# 問い合わせ先メール（設定・エラー画面・特商法などに表示）
VITE_SUPPORT_EMAIL=
# Amazon アソシエイトのトラッキング ID（Amazon のリンクの URL に出る）
VITE_AMAZON_TAG=
