# ========== Client (Vite) ==========
# Exposed to the browser. Use the Supabase "anon" key ONLY — never the service key.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...

# ========== Server (Vercel serverless / api/*) ==========
# Used by api/claude.js to verify Supabase JWTs on incoming requests.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbG...

# ========== Anthropic API ==========
# Server-side only. Never expose this key to the client.
ANTHROPIC_API_KEY=sk-ant-...
