{
  "appId": "jp.orime.app",
  "appName": "orime",
  "webDir": "dist",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#f7f5f1",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
