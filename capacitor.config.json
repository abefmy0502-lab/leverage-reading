{
  "appId": "com.leveragereading.app",
  "appName": "Leverage Reading",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#EDE0CA"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#EDE0CA",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
